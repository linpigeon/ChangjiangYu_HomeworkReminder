<?xml version="1.0" encoding="utf-8"?>
<!--
  Offline restore configuration.

  Why this file exists: in this sandbox .NET cannot complete a TLS handshake
  against api.nuget.org ("安全包中没有可用的凭证" / SEC_E_NO_CREDENTIALS), and the
  machine-wide package cache (~/.nuget/packages) is outside the writable sandbox
  boundary, so packages cannot be fetched from nuget.org at restore time.

  `packages/` is a local folder feed holding the few packages the sandbox cannot
  obtain. Packages already present in the machine-wide NuGet cache (including the
  Avalonia 12.0.3 set) resolve from there as usual — the global packages folder
  is deliberately left at its default so that cache is reused.

  ── 在其他机器上如何使用 ────────────────────────────────────────────────
  本文件是「离线还原」配置：唯一的包源是仓库内的 packages/ 文件夹，
  nuget.org 被 <clear /> 移除了。在能正常访问网络的机器上：

    1. 直接删除本文件（以及 packages/、.nuget-packages/），即可恢复默认的
       nuget.org 在线还原；或者
    2. 取消下面注释掉的 nuget.org 源，让在线源与本地源并存。

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  注意：globalPackagesFolder=.nuget-packages 是把解包目录固定在仓库内，
  换机后若不再受沙箱限制，可连同 <config> 一节一起删除，恢复默认缓存位置。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="local-offline" value="packages" />
    <!-- 在线环境取消下一行注释即可恢复 nuget.org：
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    -->
  </packageSources>
  <config>
    <!--
      The machine-wide cache lives at D:\DevCache\nuget, which is outside the
      writable sandbox boundary, so restore cannot extract newly resolved
      packages there. Keep the extracted tree inside the workspace instead.
    -->
    <add key="globalPackagesFolder" value=".nuget-packages" />
  </config>
</configuration>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HomeworkReminder.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="252" d:DesignHeight="700"
             x:Class="HomeworkReminder.Views.SidebarView"
             x:DataType="vm:MainViewModel">

  <!--
    侧边栏内容（用户资料 + 导航 + 状态栏）。
    宽屏：放在三栏布局的第一列；窄屏（手机）：作为覆盖式抽屉浮层复用。
    抽成 UserControl 就是为了两种布局共用同一份结构，样式不分叉。
  -->
  <Border Background="{Binding SidebarBrush}">
    <Grid RowDefinitions="Auto,*,Auto">

      <!-- 顶部：用户 + 刷新 -->
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="16,14,10,10">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
          <!-- 头像：有图用图，没图用姓名首字占位 -->
          <Panel Width="34" Height="34" VerticalAlignment="Center">
            <Border CornerRadius="17" Background="{DynamicResource TodoAccent}"
                    IsVisible="{Binding !HasAvatar}">
              <TextBlock Text="{Binding UserInitial}" Foreground="White"
                         FontSize="15" FontWeight="SemiBold"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Border CornerRadius="17" ClipToBounds="True" IsVisible="{Binding HasAvatar}">
              <Image Source="{Binding UserAvatar}" Stretch="UniformToFill" />
            </Border>
          </Panel>

          <StackPanel VerticalAlignment="Center" MaxWidth="150">
            <TextBlock Text="{Binding UserName}" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource TodoTextPrimary}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding UserName}" />
            <TextBlock Text="{Binding UserSubtitle}" FontSize="11"
                       Foreground="{DynamicResource TodoTextTertiary}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding UserSubtitle}" />
          </StackPanel>
        </StackPanel>

        <Button Grid.Column="1" Classes="tool" Click="OnRefreshClick"
                ToolTip.Tip="立即同步（再次点击可取消）">
          <TextBlock Classes="icon" Text="&#xF021;" />
        </Button>
      </Grid>

      <!-- 导航 -->
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding NavItems}" Margin="6,4">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:NavItem">
              <Border Name="NavRow" Classes="navrow"
                      Classes.selected="{Binding IsSelected}"
                      Tapped="OnNavTapped"
                      Margin="0,1">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="10,8">
                  <TextBlock Grid.Column="0" Classes="icon" Text="{Binding Glyph}"
                             Foreground="{DynamicResource TodoAccent}" />
                  <TextBlock Grid.Column="1" Text="{Binding Label}" Margin="12,0,0,0"
                             FontSize="13" VerticalAlignment="Center"
                             Foreground="{DynamicResource TodoTextPrimary}" />
                  <Border Grid.Column="2" Classes="badge" IsVisible="{Binding HasBadge}">
                    <TextBlock Text="{Binding BadgeText}" />
                  </Border>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- 底部：操作按钮。登录态/同步状态等信息已移到「设置 → 关于」。 -->
      <StackPanel Grid.Row="2" Margin="16,8,16,14" Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Classes="outline" Content="退出登录" Click="OnLogoutClick"
                  HorizontalAlignment="Left" Padding="10,5" FontSize="11" />
          <Button Classes="tool" ToolTip.Tip="设置" Click="OnSettingsClick">
            <TextBlock Classes="icon" Text="&#xF013;" />
          </Button>
        </StackPanel>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HomeworkReminder.ViewModels"
             xmlns:views="using:HomeworkReminder.Views"
             xmlns:models="using:HomeworkReminder.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="760"
             x:Class="HomeworkReminder.Views.TodoShellView"
             x:DataType="vm:MainViewModel">

  <!--
    桌面外壳：三栏（导航 / 列表 / 详情）。
    移动端外壳是 Android 工程里的 MobileShellView（抽屉式布局），
    与这里共用同一 MainViewModel 与 SidebarView/TodoListView/TodoDetailView 部件。
  -->
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="{Binding SidebarColumnWidth}" />
      <ColumnDefinition Width="400" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ClipToBounds：列宽收起为 0 时内容不能溢出绘制 -->
    <views:SidebarView Grid.Column="0" ClipToBounds="True" />
    <views:TodoListView Grid.Column="1" />
    <views:TodoDetailView Grid.Column="2" Background="{Binding SurfaceBrush}" />
  </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HomeworkReminder.ViewModels"
             xmlns:views="using:HomeworkReminder.Views"
             xmlns:models="using:HomeworkReminder.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="760"
             x:Class="HomeworkReminder.Views.TodoShellView"
             x:DataType="vm:MainViewModel">

  <!--
    桌面外壳：三栏（导航 / 列表 / 详情），栏间有 GridSplitter 可自由拖宽，
    宽度在拖动结束后由代码后置记入 settings.json（PersistPaneWidths）。

    注意：栏宽不做绑定——GridSplitter 拖动时用 SetValue 写 ColumnDefinition.Width，
    会把绑定顶掉，此后 ViewModel 侧的变化（如收起侧边栏）就到不了界面。
    所以初始宽度与收起/展开都由 TodoShellView 代码后置显式应用。

    设置页与待办区用 IsVisible 硬切保证终态正确，切换时的淡入由
    pagefadein 关键帧动画负责（只淡入，不做淡出——见 TodoTheme.axaml 的说明）。
  -->
  <Grid x:Name="ShellGrid">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="252" />
      <ColumnDefinition Width="5" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ClipToBounds：列宽收起为 0 时内容不能溢出绘制 -->
    <views:SidebarView Grid.Column="0" ClipToBounds="True" />
    <GridSplitter Grid.Column="1" Classes="colsplit" DragCompleted="OnSplitterDragCompleted"
                  IsVisible="{Binding !SidebarCollapsed}" />

    <Grid Grid.Column="2">
      <!-- 待办区：列表 + 分隔条 + 详情 -->
      <Grid x:Name="TodoPane"
            IsVisible="{Binding !SettingsOpen}"
            Classes.pagefadein="{Binding !SettingsOpen}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="400" MinWidth="220" />
          <ColumnDefinition Width="5" />
          <ColumnDefinition Width="*" MinWidth="280" />
        </Grid.ColumnDefinitions>

        <views:TodoListView Grid.Column="0" />
        <GridSplitter Grid.Column="1" Classes="colsplit" DragCompleted="OnSplitterDragCompleted" />
        <views:TodoDetailView Grid.Column="2" Background="{Binding SurfaceBrush}" />
      </Grid>

      <!-- 设置页：与待办区同格叠加（内嵌页面，不是弹窗） -->
      <views:SettingsView IsVisible="{Binding SettingsOpen}"
                          Classes.pagefadein="{Binding SettingsOpen}" />
    </Grid>
  </Grid>
</UserControl>

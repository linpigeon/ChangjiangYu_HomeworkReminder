<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HomeworkReminder.ViewModels"
             xmlns:views="using:HomeworkReminder.Views"
             xmlns:models="using:HomeworkReminder.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="760"
             x:Class="HomeworkReminder.Views.TodoShellView"
             x:DataType="vm:MainViewModel">

  <!--
    桌面外壳：三栏（导航 / 列表 / 详情），栏间有 GridSplitter 可自由拖宽，
    宽度在拖动结束后由代码后置记入 settings.json（PersistPaneWidths）。

    注意：栏宽不做绑定——GridSplitter 拖动时用 SetValue 写 ColumnDefinition.Width，
    会把绑定顶掉，此后 ViewModel 侧的变化（如收起侧边栏）就到不了界面。
    所以初始宽度与收起/展开都由 TodoShellView 代码后置显式应用。

    设置页与待办区用 IsVisible 硬切保证终态正确，切换时的淡入由
    pagefadein 关键帧动画负责（只淡入，不做淡出——见 TodoTheme.axaml 的说明）。
  -->
  <Grid x:Name="ShellGrid">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="252" />
      <ColumnDefinition Width="5" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ClipToBounds：列宽收起为 0 时内容不能溢出绘制 -->
    <views:SidebarView Grid.Column="0" ClipToBounds="True" />
    <GridSplitter Grid.Column="1" Classes="colsplit" DragCompleted="OnSplitterDragCompleted"
                  IsVisible="{Binding !SidebarCollapsed}" />

    <Grid Grid.Column="2">
      <!-- 待办区：列表 + 分隔条 + 详情 -->
      <Grid x:Name="TodoPane"
            IsVisible="{Binding ShowTodoPane}"
            Classes.pagefadein="{Binding ShowTodoPane}">
        <Grid.ColumnDefinitions>
          <!--
            列表栏用 `*` + MaxWidth，而不是固定 400；**MaxWidth 由代码后置按记忆宽度写入**。
            「固定 400」在窄窗口上会把详情栏整体挤出窗口：
            实测（androidcheck desktop，960x760 这个最小桌面尺寸）
            列表 400 + 分隔条 5 + 详情 MinWidth 280 = 685，大于外层可用的 664，
            详情栏被顶到 x=952.8、右边缘 1232.8，**超出窗口 272.8dp**——
            半个详情面板画在窗口外，而外层 Grid 没有 ClipToBounds，只能靠肉眼发现。
            改为「上限 = 记忆宽度」后：宽窗口按记忆宽度（默认 400）分配，
            窗口变窄时自动收窄，用户拖动后上限跟着更新（见 ApplyWidths）。
          -->
          <ColumnDefinition Width="*" MinWidth="220" />
          <ColumnDefinition Width="5" />
          <ColumnDefinition Width="*" MinWidth="280" />
        </Grid.ColumnDefinitions>

        <views:TodoListView Grid.Column="0" />
        <GridSplitter Grid.Column="1" Classes="colsplit" DragCompleted="OnSplitterDragCompleted" />
        <views:TodoDetailView Grid.Column="2" Background="{Binding SurfaceBrush}" />
      </Grid>

      <!-- 设置页：与待办区同格叠加（内嵌页面，不是弹窗） -->
      <views:SettingsView IsVisible="{Binding SettingsOpen}"
                          Classes.pagefadein="{Binding SettingsOpen}" />

      <!--
        课表页：同样是整页覆盖。之所以不复用中间那 400px 的列表栏——
        7 天 + 节次列挤在 400px 里读不清，网格需要宽度。
      -->
      <views:TimetableView IsVisible="{Binding TimetableOpen}"
                           Classes.pagefadein="{Binding TimetableOpen}" />

      <!-- 教务导入页：盖在课表页之上（从课表页的「导入课表」进入） -->
      <views:JwImportView IsVisible="{Binding JwImportOpen}"
                          Classes.pagefadein="{Binding JwImportOpen}" />
    </Grid>

    <!-- 登录覆盖层（雨课堂 / 学习通，从设置页「账号」进入；启动不再弹登录） -->
    <Border Grid.Column="2" Background="{DynamicResource TodoDialogBackground}"
            IsVisible="{Binding LoginPageOpen, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Grid RowDefinitions="Auto,*">
        <Button Grid.Row="0" Classes="tool" Click="OnLoginBackClick"
                Margin="10,10,0,0" HorizontalAlignment="Left"
                ToolTip.Tip="返回设置">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Classes="icon" Text="&#xF060;" />
            <TextBlock Text="返回" FontSize="13" VerticalAlignment="Center"
                       Foreground="{DynamicResource TodoTextSecondary}" />
          </StackPanel>
        </Button>
        <Panel Grid.Row="1">
          <views:LoginView IsVisible="{Binding YktLoginOpen}" />
          <views:ChaoxingLoginView IsVisible="{Binding ChaoxingLoginOpen}" />
          <views:PigaiLoginView IsVisible="{Binding PigaiLoginOpen}" />
        </Panel>
      </Grid>
    </Border>
  </Grid>
</UserControl>

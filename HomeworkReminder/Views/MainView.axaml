<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HomeworkReminder.ViewModels"
             xmlns:views="using:HomeworkReminder.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="760"
             x:Class="HomeworkReminder.Views.MainView"
             x:DataType="vm:MainViewModel">
  <!--
    Browser / 单视图 / 移动端平台的根视图。桌面端用的是 MainWindow。
    内容外壳由平台决定：默认 TodoShellView（桌面三栏）；移动端头部工程
    （Android）通过 App.MobileShellFactory 注入 MobileShellView（抽屉式）。
  -->
  <Panel>
    <ContentControl Name="ShellHost" IsVisible="{Binding ShowContent}" />
    <views:LoginView IsVisible="{Binding ShowLogin}" />
  </Panel>
</UserControl>

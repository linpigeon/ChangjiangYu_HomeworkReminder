<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- 应用版本号统一在仓库根目录的 Directory.Build.props 里定义，此处不再重复。 -->
  </PropertyGroup>
  
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <!--
      更新替换器脚本：以嵌入资源随程序分发，运行时释放到临时目录执行。
      单独声明为 EmbeddedResource（而不是只靠上面的 AvaloniaResource），
      是为了让读取端用明确、稳定的资源名，不受 Avalonia 资源命名规则影响。
    -->
    <EmbeddedResource Include="Assets\apply-update.ps1" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <!-- 登录页内嵌雨课堂官方登录页，需要 WebView 控件。 -->
    <PackageReference Include="Avalonia.Controls.WebView" />
  </ItemGroup>

  <ItemGroup>
    <!--
      教务课表解析的回归样本：从真实教务页（珠海科技学院正方系统）抓下来的课表表格片段。
      离线自检（jsoncheck）用它验证「真机抓到的页面能被解析出课程」；这一条曾经整条失效
      （InvokeScript 的 JSON 壳没拆，标记压根进不了解析器），离线样本是唯一的防复发手段。
    -->
    <None Include="..\docs\fixtures\zcst-kblist-table.html"
          Link="fixtures\zcst-kblist-table.html"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

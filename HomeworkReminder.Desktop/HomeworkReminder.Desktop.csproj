<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--If you are willing to use platform-specific APIs, use conditional compilation.
    See https://docs.avaloniaui.net/docs/guides/platforms/platform-specific-code/dotnet for more details.-->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- 桌面头是 Windows 专用的（WinRT toast、DPAPI、ShellLink 都是 Windows API）。
         在这里声明一次，平台分析器就不会为每个调用点报 CA1416；
         共享项目里需要跨平台的部分仍各自用 OperatingSystem.IsWindows() 守卫。 -->
    <SupportedOSPlatform>windows</SupportedOSPlatform>
  </PropertyGroup>

  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- exe 图标（资源管理器/任务栏显示）；窗口与托盘图标用同一份 ico -->
    <ApplicationIcon>..\HomeworkReminder\Assets\app.ico</ApplicationIcon>
    <!-- 裁剪发布（PublishTrimmed）下反射式 JSON 不可靠：实测 trim 版登录后同步
         即崩（YktCourse 的反射元数据被裁）。业务序列化已全部改走源生成的
         AppJsonContext；此开关仅作为漏网路径的兜底保留，正常流程不再依赖反射。 -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Controls.WebView" />
  </ItemGroup>

  <!--
    裁剪保留：System 通知依赖 [ComImport] 接口互操作（ShellLink 写 AUMID 快捷方式）。
    裁剪会丢掉这些接口的元数据，后果**只在分发包里出现**（非裁剪构建正常）：
      ① 不开 BuiltInComInteropSupport（裁剪默认）→ 构造 WindowsNotifier 抛
         NotSupportedException: Built-in COM has been disabled via a feature switch，
         界面提示「系统通知不可用」；
      ② 开了它但接口被裁 → IPropertyStore.Commit() 处 0xC0000005 访问冲突。
    实测 v1.4.0 裁剪包两者都撞上了。

    做法上踩过两次坑，记下来免得重蹈：
      · 先用 ILLink.Descriptors.xml + TrimmerRootDescriptor：清单格式是对的，
        但 ILLink 直接 IL1012 内部崩溃（Fatal error in IL Linker），这条路走不通。
      · 最终用 TrimmerRootAssembly 把桌面头整体排除在裁剪之外。桌面头本就不大，
        换来确定性；框架与可裁剪包照旧被裁，「部分裁剪」的设计不受影响。
    必须同时有 -p:BuiltInComInteropSupport=true（在 tools/publish.ps1 的 trim 模式里），
    否则连内置 COM 都被关掉。
    验证：publish\trim\HomeworkReminder.Desktop.exe 加 －－toastcheck 参数运行，
          应打印「通知可用性 : 可用」（与内存中的非裁剪构建一致）。
          （此处刻意用全角连字符：XML 注释里不允许出现连续两个半角连字符。）
  -->
  <ItemGroup>
    <TrimmerRootAssembly Include="HomeworkReminder.Desktop" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HomeworkReminder\HomeworkReminder.csproj" />
  </ItemGroup>
</Project>
